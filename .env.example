# Скопируйте в .env и задайте свои значения. Файл .env не коммитится.

# --- PostgreSQL (docker compose) ---
POSTGRES_DB=clinical_compass
POSTGRES_USER=clinical_compass
POSTGRES_PASSWORD=change-me
APP_PORT=8080

# --- Backend (префикс CC_) ---
# Локально без Docker по умолчанию используется SQLite: sqlite:///./data/clinical_compass.db
# CC_DATABASE_URL=postgresql+psycopg://clinical_compass:change-me@localhost:5432/clinical_compass

# Ключ внутренних эндпоинтов AI-слоя (заголовок X-Internal-Token). Обязательно смените.
CC_INTERNAL_TOKEN=change-me-internal-token

# Демо-режим: вход по id без пароля и вымышленные данные в пустой базе.
# Для любого стенда с реальными людьми — false.
CC_DEMO_AUTH=true
CC_SEED_DEMO_DATA=true

# Интеграция с МИС: ключи серверных вызовов (X-Integration-Key) и кто может встраивать окно.
CC_INTEGRATION_KEYS={"emias": "change-me-emias-key", "onec": "change-me-onec-key"}
CC_FRAME_ANCESTORS=["'self'"]

# Разрешённые источники для браузерных клиентов с другого адреса (JSON-список).
CC_CORS_ORIGINS=["http://localhost:8080"]

# Часовой пояс клиники (смещение от UTC, часы) и время жизни сессии.
CC_CLINIC_UTC_OFFSET_HOURS=3
CC_SESSION_TTL_HOURS=12

# --- AI / NLP extraction ---
# По умолчанию остаётся безопасная заглушка. Для нашей integration-ветки можно подключить
# отдельный AI service, который возвращает FreeTextExtraction v0.2.
CC_EXTRACTOR_MODE=mock
# CC_EXTRACTOR_MODE=remote
# CC_EXTRACTOR_URL=http://127.0.0.1:8090/extract
# Общий токен с ai_service (там — AI_SERVICE_TOKEN), минимум 16 символов.
# CC_EXTRACTOR_TOKEN=
# CC_EXTRACTOR_TIMEOUT_SECONDS=20
